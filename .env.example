# Every value the server reads. Copy to `.env` and edit; `.env` is git-ignored.
# Lists are JSON, not comma-separated: ALLOWED_HOSTS='["mcp.example.com"]'

# ---- MCP server ----------------------------------------------------------------------------------------------------
# Sent to the client during the handshake and shown by inspector UIs.
MCP_NAME=McpSquelette

# http: serve Streamable HTTP on POST /mcp (what the container does).
# stdio: talk over the process's pipes, for a client that launches the server itself.
MCP_TRANSPORT=http

# ---- HTTP server ---------------------------------------------------------------------------------------------------
# 0.0.0.0 listens on every interface, which is what a container needs.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Host header allow-list. "*" accepts any host and disables the check: set the real hostname before
# exposing the server, or it answers to any name pointed at its IP.
ALLOWED_HOSTS='["*"]'

# Browser origins allowed to call the server. Empty rejects every cross-origin browser request,
# which is correct until a browser-based client needs in.
ALLOWED_ORIGINS='[]'

# Peers whose X-Forwarded-For is believed. Widen it only to your reverse proxy or every caller
# behind it, otherwise a caller can forge the address the rate limiter keys on.
TRUSTED_PROXY_HOSTS='["127.0.0.1"]'

# ---- Outbound HTTP -------------------------------------------------------------------------------------------------
# Applied to the single client the lifespan opens: every tool inherits both values.
HTTP_TIMEOUT_SECONDS=10
# Many public APIs reject the default Python user agent, so it is set once, here.
HTTP_USER_AGENT=McpSquelette/0.1 (+https://github.com/Mirlon382/McpSquelette)

# ---- Rate limiting -------------------------------------------------------------------------------------------------
# Per client address, sliding window: 100 requests per minute by default.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# ---- Logging -------------------------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. FastMCP's own middlewares log under `fastmcp.*`.
LOG_LEVEL=INFO
